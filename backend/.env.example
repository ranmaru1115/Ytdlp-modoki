# サーバー設定
PORT=4000
HOST=0.0.0.0

# 実行ファイルパス (Windows実行ファイルまたはPATH上のコマンド名)
YTDLP_PATH=C:\Users\Ranmaru\yt-dlp.exe
FFMPEG_PATH=C:\Users\Ranmaru\Downloads\ffmpeg-master-latest-win64-gpl-shared\ffmpeg-master-latest-win64-gpl-shared\bin\ffmpeg.exe

# ジョブ & リソース管理
MAX_CONCURRENT_JOBS=2
FILE_TTL_MINUTES=30

# セキュリティ
# 未設定の場合はAPI認証なし(LAN/個人用)、設定した場合は X-API-Key または Authorization: Bearer で検証
API_TOKEN=

# CORS設定 (カンマ区切り)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ytdlp-modoki.vercel.app
